# Copy to .env.seed.local. Use ONLY your new development Supabase project.
SEED_SUPABASE_URL=https://YOUR_NEW_PROJECT_REF.supabase.co
SEED_SUPABASE_SECRET_KEY=YOUR_NEW_PROJECT_SECRET_OR_SERVICE_ROLE_KEY
# Direct or session-pooler PostgreSQL connection string. URL-encode the password.
SEED_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_NEW_PROJECT_REF.supabase.co:5432/postgres
SEED_USER_PASSWORD=CHOOSE_A_UNIQUE_DEMO_PASSWORD_AT_LEAST_12_CHARACTERS
SEED_EMAIL_DOMAIN=demo.example.test
SEED_WEBSITE_URL=http://localhost:3003
# Optional: defaults to today's date in America/Toronto.
# SEED_ANCHOR_DATE=2026-10-24
